{
  "name": "daily-message",
  "version": "1.0.0",
  "description": "定時向OpenAI API發送訊息並轉發到Telegram Bot的服務",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "init-db": "node scripts/init-db.js",
    "dev:init": "npm run init-db && npm run dev",
    "test": "node scripts/test-core.js",
    "docker:build": "docker build -t daily-message .",
    "docker:run": "docker run -p 3000:3000 -v ./data:/app/data daily-message",
    "docker:compose": "docker-compose up -d"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "better-sqlite3": "^11.8.1",
    "lucide-react": "^0.525.0",
    "next": "15.4.2",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "openai": "^5.10.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
